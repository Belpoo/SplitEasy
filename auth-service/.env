# Archivo: .env.example
# Propósito: Variables documentadas en español usadas en el servidor auth.

# Cadena de conexión postgres (Asegúrate de que Docker Desktop esté corriendo)
DATABASE_URL=postgresql://auth_user:auth_password@localhost:5432/auth_db

# Puerto donde levanta Fastify internamente
PORT=3001

# Llave privada de signado y resolución de JSON Web Tokens
JWT_SECRET=secreto_para_testing_local

# Llave de compaginado en encriptación para fastify-cookie
COOKIE_SECRET=mi-super-secreto-cookie-123456789

