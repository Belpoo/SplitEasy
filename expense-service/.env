# Base Config del Servicio de Gastos
PORT=8081

# Archivo de conector Base (Asegúrate de que Docker esté corriendo y la DB creada)
# La DB de gastos corre en el 5434 por convención de este proyecto
DATABASE_URL=postgresql://exp_user:exp_password@localhost:5434/exp_db?sslmode=disable

# Bandera de Arquitectura Serverless Broker
# Ponlo en 'false' para evitar errores si no tienes RabbitMQ corriendo.
# El código tiene un simulador que imprime en consola si es false.
USE_BROKER=false

# URL de AMQP (Nulo si USE_BROKER es false)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
